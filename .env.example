# Optional absolute URL for multiplayer Socket.IO backend.
# Must be http:// or https:// when set.
# - Local browser dev can leave this empty to use same-origin fallback.
# - Android packaged WebView runtime should set this to a reachable remote backend.
VITE_SOCKET_URL=""

# Optional comma-separated origins allowed by the Socket.IO server CORS policy.
# Include https://appassets.androidplatform.net for Android WebView clients.
SOCKET_CORS_ORIGINS=""
