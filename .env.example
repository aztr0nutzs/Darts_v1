# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SOCKET_URL: Optional absolute URL for the multiplayer Socket.IO backend.
# Expected format: https://your-backend.example
# Local web dev can omit this to use the same-origin dev server fallback.
# Android APK multiplayer requires this to point at a reachable remote backend;
# packaged appassets content cannot use same-origin Socket.IO.
VITE_SOCKET_URL=""

# SOCKET_CORS_ORIGINS: Optional comma-separated list of browser/WebView origins
# allowed to connect to the Socket.IO server.
# Include https://appassets.androidplatform.net for Android WebView clients.
# If omitted, the server allows APP_URL, local dev origins in development, and
# the Android WebView appassets origin.
SOCKET_CORS_ORIGINS=""
